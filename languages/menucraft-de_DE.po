#: admin/partials/menucraft-admin-help.php:153
msgid "Where the sizes and prices are shown."
msgstr "Wo die Größen und Preise angezeigt werden."

#: admin/partials/menucraft-admin-help.php:156
msgid "shown directly on the item card."
msgstr "direkt auf der Artikelkarte angezeigt."

#: admin/partials/menucraft-admin-help.php:157
